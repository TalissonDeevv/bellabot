# Observatório público da Bella (Vercel + Neon)
# O segredo deve ser o mesmo configurado dentro de BELLA_INGESTION_KEYS na Vercel.
BELLA_OBSERVATORY_ENABLED=false
BELLA_OBSERVATORY_URL=https://bellanyellebot.vercel.app
BELLA_OBSERVATORY_KEY_ID=bella-bot-prod
BELLA_OBSERVATORY_SECRET=
BELLA_OBSERVATORY_INTERVAL_SECONDS=60
BELLA_OBSERVATORY_SYNC_INTERVAL_SECONDS=300
BELLA_OBSERVATORY_TIMEOUT_SECONDS=15
BELLA_OBSERVATORY_MAX_ATTEMPTS=3
BELLA_VERSION=2026.10

# Central de Manutenção
MAINTENANCE_PANEL_CHANNEL_ID=1561342090238234654


# --- Agente da Bella ---
# Chave do Stripe para links de pagamento. Também dá para configurar pelo botão
# que a Bella manda por DM. Prefira chave restrita (rk_) e comece pela de teste.
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=brl
# Briefing diário por DM ao proprietário
AGENT_DAILY_BRIEFING=true
AGENT_BRIEFING_HOUR=8
AGENT_BRIEFING_MINUTE=0
AGENT_TIMEZONE=America/Sao_Paulo
GROQ_REASONING_EFFORT=low

# --- FreeLLMAPI (roteador de IAs grátis) ---
# O instalar_servidor.sh preenche FREELLMAPI_BASE_URL com a porta escolhida.
FREELLMAPI_ENABLED=false
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=
# Lista em ordem, separada por virgula: se um modelo falhar ou demorar, a Bella
# tenta o proximo. Modelo especifico responde em ~1 s; "auto" pode passar de 20 s.
# Gemini fica por ultimo: e a chave que a Bella ja usava, so de reserva.
FREELLMAPI_MODEL=gpt-oss-120b,poolside/laguna-xs-2.1,nvidia/nemotron-3.5-lightning-30b-a3b,cohere/north-mini-code:free,qwen3.8-27b,gpt-oss-20b,gemini-2.5-flash,gemini-2.5-flash-lite
FREELLMAPI_JSON_MODEL=gpt-oss-120b,poolside/laguna-xs-2.1,nvidia/nemotron-3.5-lightning-30b-a3b,cohere/north-mini-code:free,gpt-oss-20b,gemini-2.5-flash
FREELLMAPI_VISION_MODEL=qwen3.8-27b,Qwen2.5-VL-72B-Instruct,gemini-2.5-flash,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Com a FreeLLMAPI ligada, toda a IA passa so por ela. true religa a Groq
# direta como reserva (usa GROQ_API_KEY fora da FreeLLMAPI).
FREELLMAPI_DIRECT_FALLBACK=false
FREELLMAPI_TIMEOUT_SECONDS=20
FREELLMAPI_ATTEMPT_TIMEOUT_SECONDS=10

# Robustez da FreeLLMAPI (docs/BELLA_AGENTE_DONO.md)
FREELLMAPI_TOTAL_TIMEOUT_SECONDS=40
FREELLMAPI_MAX_RETRIES=2
FREELLMAPI_BACKOFF_SECONDS=0.6

# Memória: IDs extras (além do dono) que podem gravar memória global, separados por vírgula
BELLA_OWNER_IDS=

# Lembretes por DM
REMINDER_TIMEZONE=America/Recife
